{
  "name": "shikakun.com",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @shikakun/web dev",
    "build": "pnpm -r build",
    "lint": "biome check . && markuplint 'apps/web/src/**/*.astro' 'apps/web/src/**/*.mdx'",
    "lint:fix": "biome check --write . && markuplint --fix 'apps/web/src/**/*.astro' 'apps/web/src/**/*.mdx'",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "pnpm --filter @shikakun/react test",
    "test:e2e": "playwright test",
    "storybook": "pnpm --filter @shikakun/react storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@playwright/test": "1.59.1",
    "@axe-core/playwright": "4.11.2",
    "markuplint": "4.14.1",
    "@markuplint/astro-parser": "4.6.23",
    "wrangler": "4.84.0",
    "@changesets/cli": "2.31.0"
  }
}
