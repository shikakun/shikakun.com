{
  "name": "shikakun.com",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "pnpm --filter @shikakun/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check . && markuplint 'apps/web/src/**/*.astro' 'apps/web/src/**/*.mdx'",
    "lint:fix": "biome check --write . && markuplint --fix 'apps/web/src/**/*.astro' 'apps/web/src/**/*.mdx'",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "pnpm --filter @shikakun/react test",
    "test:e2e": "playwright test",
    "storybook": "pnpm --filter @shikakun/react storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "1.60.0",
    "@axe-core/playwright": "4.11.3",
    "markuplint": "4.18.3",
    "@markuplint/astro-parser": "4.18.3",
    "wrangler": "4.95.0",
    "@changesets/cli": "2.31.0"
  },
  "pnpm": {
    "//": "@storybook/test-runner@0.24.4 が playwright-core@1.59.1 に依存するため playwright-core を 1.60.0 に揃えたワークアラウンド。test-runner が playwright-core@1.60.0 に追従したら overrides ごと削除する",
    "overrides": {
      "playwright-core": "1.60.0"
    }
  }
}
