{
  "name": "@shikakun/react",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./css": {
      "import": "./dist/index.css",
      "types": "./types/css.d.ts"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --project tsconfig.build.json --emitDeclarationOnly --declarationDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@shikakun/design-tokens": "workspace:*",
    "aria-attribute-types": "1.0.0",
    "budoux": "0.8.4",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@storybook/test-runner": "0.24.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "storybook": "10.6.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
