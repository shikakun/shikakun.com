---
import { Image } from 'astro:assets';
import { NavigationMenu } from '@shikakun/react';
import shikakun from '../assets/brand/shikakun.png';
import styles from './SiteNavigation.module.css';

type Props = {
  label?: string;
};

const { label = 'サイトナビゲーション' } = Astro.props;
const { pathname } = Astro.url;

const rawItems = [
  { href: '/', label: 'Home' },
  { href: '/poetry/', label: 'Poetry' },
  { href: '/banana/', label: 'Podcast' },
  { href: '/manzai/', label: 'Manzai' },
];

const items = rawItems.map(({ href, label }) => ({
  href,
  label,
  isCurrent: pathname === href || pathname.startsWith(`${href}/`),
}));
---

<nav class={styles.nav} aria-label={label}>
  <a class={styles.icon} href="/" aria-hidden="true" tabindex="-1">
    <Image src={shikakun} class={styles.shikakun} alt="shikakunのアイコン" />
  </a>
  <NavigationMenu client:load items={items} />
</nav>
