---
import type { ImageMetadata } from 'astro';
import SiteNavigation from '~/components/SiteNavigation.astro';
import {
  GA_MEASUREMENT_ID,
  SITE_DESCRIPTION,
  SITE_LANG,
  SITE_REGION,
  SITE_TITLE,
  SITE_X_ID,
} from '~/consts';
import styles from './Layout.module.css';
import '@shikakun/design-tokens/css';
import '@shikakun/react/css';
import '~/styles/global.css';
import '~/styles/bracket-syntax.css';
import appleTouchIcon from '~/assets/apple-touch-icon.png';
import favicon16 from '~/assets/favicon-16.png';
import favicon32 from '~/assets/favicon-32.png';
import favicon192 from '~/assets/favicon-192.png';
import favicon512 from '~/assets/favicon-512.png';
import defaultOgImage from '~/assets/og.png';

type Props = {
  title: string;
  description?: string;
  isHome?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
};

const {
  title,
  description = SITE_DESCRIPTION,
  isHome = false,
  ogType = 'website',
  ogImage = defaultOgImage,
  ogImageAlt = SITE_TITLE,
  publishedTime,
  modifiedTime,
  tags,
} = Astro.props;

const MIME_TYPE: Record<string, string> = {
  png: 'image/png',
  jpg: 'image/jpeg',
  jpeg: 'image/jpeg',
  webp: 'image/webp',
  avif: 'image/avif',
  gif: 'image/gif',
  svg: 'image/svg+xml',
};

const pageTitle = isHome ? SITE_TITLE : `${title} — ${SITE_TITLE}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage.src, Astro.site);
const ogImageType = MIME_TYPE[ogImage.format] ?? `image/${ogImage.format}`;
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content={`${SITE_LANG}_${SITE_REGION}`} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    {
      ogType === 'article' && (
        <>
          {publishedTime && (
            <meta property="article:published_time" content={publishedTime} />
          )}
          {modifiedTime && (
            <meta property="article:modified_time" content={modifiedTime} />
          )}
          {tags?.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${SITE_X_ID}`} />
    <meta name="twitter:creator" content={`@${SITE_X_ID}`} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
    <link rel="icon" type="image/png" sizes="512x512" href={favicon512.src} />
    <link rel="icon" type="image/png" sizes="192x192" href={favicon192.src} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16.src} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href="/feed.xml"
    />

    {
      import.meta.env.PROD && GA_MEASUREMENT_ID && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
          />
          <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', GA_MEASUREMENT_ID);
          </script>
        </>
      )
    }
  </head>
  <body class={styles.body}>
    <div class={styles.wrapper}>
    <SiteNavigation label="ページ上部のサイトナビゲーション" />
    <div class={styles.container}>
      <slot />
    </div>
    </div>
    <SiteNavigation label="ページ下部のサイトナビゲーション" />
  </body>
</html>
