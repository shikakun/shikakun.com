---
import { getCollection } from 'astro:content';
import ArticlePage from '../components/ArticlePage.astro';
import TagPage from '../components/TagPage.astro';

type Page = Awaited<ReturnType<typeof getCollection<'pages'>>>[number];

type Props = { type: 'page'; page: Page } | { type: 'tag'; tag: string; tagPages: Page[] };

export async function getStaticPaths() {
  const allPages = await getCollection('pages');
  const tags = [...new Set(allPages.flatMap((p) => p.data.tags ?? []))];

  function sortKey(page: Page): string {
    return page.data.displayDate || page.data.date?.toISOString().slice(0, 10) || '';
  }

  return [
    ...allPages.map((page) => ({
      params: { slug: page.id },
      props: { type: 'page' as const, page },
    })),
    ...tags.map((tag) => ({
      params: { slug: tag },
      props: {
        type: 'tag' as const,
        tag,
        tagPages: allPages
          .filter((p) => p.data.tags?.includes(tag))
          .sort((a, b) => sortKey(b).localeCompare(sortKey(a))),
      },
    })),
  ];
}

const props = Astro.props as Props;
---

{props.type === 'page'
  ? <ArticlePage page={props.page} />
  : <TagPage tag={props.tag} tagPages={props.tagPages} />}
