---
import { getCollection } from 'astro:content';
import { Heading, PageList } from '@shikakun/react';
import Layout from '../layouts/Layout.astro';

const allPages = await getCollection('pages');

function getDate(page: (typeof allPages)[number]): string | undefined {
  return page.data.displayDate || page.data.date?.toISOString().slice(0, 10);
}

function getSortKey(page: (typeof allPages)[number]): string {
  return page.data.displayDate || page.data.date?.toISOString().slice(0, 10) || '';
}

const pages = allPages
  .filter((page) => !page.data.unlisted)
  .sort((a, b) => getSortKey(b).localeCompare(getSortKey(a)));
---

<Layout title="shikakun">
  <main>
    <Heading level={1}>shikakun</Heading>
    <PageList
      items={pages.map((page) => ({
        href: `/${page.id}`,
        title: page.data.title,
        date: getDate(page),
      }))}
    />
  </main>
</Layout>
