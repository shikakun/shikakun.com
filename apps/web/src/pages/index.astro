---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pages = await getCollection('pages');
---

<BaseLayout title="shikakun.com">
  <main>
    <h1>shikakun.com</h1>
    <ul>
      {
        pages.map((page) => (
          <li>
            <a href={`/${page.id}`}>{page.data.title}</a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
