---
import { getCollection } from 'astro:content';
import { FormattedDate } from '@shikakun/react';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPages = await getCollection('pages');

function getDate(page: (typeof allPages)[number]): string | undefined {
  return page.data.displayDate ?? page.data.date?.toISOString().slice(0, 10);
}

function getSortKey(page: (typeof allPages)[number]): string {
  return page.data.displayDate ?? page.data.date?.toISOString().slice(0, 10) ?? '';
}

const pages = allPages.sort((a, b) => getSortKey(b).localeCompare(getSortKey(a)));
---

<BaseLayout title="shikakun">
  <main>
    <h1>shikakun</h1>
    <ul>
      {
        pages.map((page) => {
          const date = getDate(page);
          return(
            <li>
              <a href={`/${page.id}`}>
                {page.data.title}
                {date && (
                  <>
                    {" "}
                    ─ <FormattedDate date={date!} />
                  </>
                )}
              </a>
            </li>
          )
        })
      }
    </ul>
  </main>
</BaseLayout>
