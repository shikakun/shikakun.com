---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPages = await getCollection('pages');

function getDate(page: (typeof allPages)[number]): string | undefined {
  return page.data.displayDate ?? page.data.date?.toISOString().slice(0, 10);
}

function getSortKey(page: (typeof allPages)[number]): string {
  if (page.data.date) {
    return page.data.date.toISOString().slice(0, 10);
  }
  return page.data.displayDate ?? '';
}

const pages = allPages.sort((a, b) => getSortKey(b).localeCompare(getSortKey(a)));
---

<BaseLayout title="shikakun">
  <main>
    <h1>shikakun</h1>
    <ul>
      {
        pages.map((page) => (
          <li>
            <a href={`/${page.id}`}>
              {page.data.title}
              {getDate(page) && (
                <>
                  {" "}
                  ─ <FormattedDate date={getDate(page)!} />
                </>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
